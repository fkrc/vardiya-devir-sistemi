# docker-compose.yml için örnek ortam değişkenleri.
# Lokal kullanım: bu dosyayı ".env" olarak kopyalayıp değerleri doldurun.
#   cp .env.example .env
#
# Test sunucusunda: bu değerler GitLab CI/CD Variables üzerinden veya
# sunucudaki /opt/vardiya-devir/.env dosyasından sağlanır (bkz. README /
# .gitlab-ci.yml açıklamaları).

# --- PostgreSQL ---------------------------------------------------------
DB_NAME=vardiya_devir
DB_USERNAME=postgres
DB_PASSWORD=changeme

# --- Frontend build-time ayarı -------------------------------------------
# Boş bırakılır; frontend backend'e nginx reverse proxy üzerinden "/api/.."
# ile aynı origin'den konuşur.
VITE_API_BASE_URL=
FRONTEND_PORT=80

# --- Container image etiketleme (GitLab CI tarafından set edilir) --------
CI_REGISTRY_IMAGE=vardiya-devir
IMAGE_TAG=latest
